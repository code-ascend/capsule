# Shell completions (regenerate: capsule completion <shell>).
install_data('completion/bash/capsule', install_dir: get_option('datadir') / 'bash-completion' / 'completions')
install_data('completion/zsh/_capsule', install_dir: get_option('datadir') / 'zsh' / 'site-functions')
install_data('completion/fish/capsule.fish', install_dir: get_option('datadir') / 'fish' / 'vendor_completions.d')
